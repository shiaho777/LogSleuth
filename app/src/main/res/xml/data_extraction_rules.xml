<?xml version="1.0" encoding="utf-8"?>
<!-- Same exclusions as backup_rules.xml, in the Android 12+ format that
     also governs device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="recordings/" />
        <exclude domain="file" path="imports/" />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="recordings/" />
        <exclude domain="file" path="imports/" />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
