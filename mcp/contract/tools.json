{
  "version": 1,
  "tools": [
    {
      "name": "status",
      "description": "Get live log access, active source, engine state, and recording status. If Android requires foreground approval, open LogSleuth on the phone.",
      "kind": "read",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false,
        "required": []
      }
    },
    {
      "name": "list_apps",
      "description": "List apps available for filtering or reporting on the selected source.",
      "kind": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string",
            "maxLength": 512
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "additionalProperties": false,
        "required": []
      }
    },
    {
      "name": "search_logs",
      "description": "Search the live buffer or a saved session. References are decimal strings. With no cursor, live queries start at the latest matching page. Supply the same filters when following a cursor.",
      "kind": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "maxLength": 19,
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "filter": {
            "type": "object",
            "properties": {
              "minLevel": {
                "type": "string",
                "enum": [
                  "V",
                  "D",
                  "I",
                  "W",
                  "E",
                  "F",
                  "A"
                ]
              },
              "levels": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "V",
                    "D",
                    "I",
                    "W",
                    "E",
                    "F",
                    "A"
                  ]
                },
                "maxItems": 7
              },
              "query": {
                "type": "string",
                "maxLength": 512
              },
              "excludeQuery": {
                "type": "string",
                "maxLength": 512
              },
              "tag": {
                "type": "string",
                "maxLength": 512
              },
              "tagExact": {
                "type": "boolean"
              },
              "regex": {
                "type": "boolean"
              },
              "package": {
                "type": "string",
                "maxLength": 255,
                "minLength": 1
              },
              "pid": {
                "type": "string",
                "maxLength": 12
              },
              "tid": {
                "type": "string",
                "maxLength": 12
              },
              "uid": {
                "type": "string",
                "maxLength": 32
              }
            },
            "additionalProperties": false,
            "required": []
          },
          "raw": {
            "type": "boolean"
          },
          "cursor": {
            "type": "string",
            "maxLength": 512
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "additionalProperties": false,
        "required": []
      }
    },
    {
      "name": "read_log_context",
      "description": "Read lines around a live sequence or a saved-session line. A live anchor also requires the source ID returned by search_logs.",
      "kind": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "maxLength": 19,
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "sourceId": {
            "type": "string",
            "maxLength": 255
          },
          "anchor": {
            "type": "string",
            "maxLength": 19,
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "before": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "after": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "raw": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "anchor"
        ]
      }
    },
    {
      "name": "clear_logs",
